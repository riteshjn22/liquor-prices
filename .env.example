# ---- Required ----
# Local: start the bundled dev database with `npm run db`, then use this value.
# Vercel: your MongoDB Atlas connection string (Atlas > Connect > Drivers).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=liquor

# Public URL of the site, no trailing slash (used for canonical URLs, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Trendswe Liquor Info
NEXT_PUBLIC_SITE_TAGLINE=Liquor Prices & Brand Information in India

# Protects /api/cron/sync. Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=change-me

# Protects /api/revalidate (used by `npm run sync` / GitHub Actions to refresh pages after a sync).
REVALIDATE_SECRET=change-me-too

# ---- Optional: ImageKit (brand bottle images) ----
# Dashboard > Developer options > URL endpoint, e.g. https://ik.imagekit.io/your_id
# Leave empty to use the built-in placeholder images.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# ---- Optional: used only by `npm run sync` to refresh a deployed site afterwards ----
SITE_URL_FOR_REVALIDATE=

# ---- Optional: only for `npm run images:link` (never exposed to the browser) ----
IMAGEKIT_PRIVATE_KEY=


# ---- Admin area (/admin: Excel export + import) ----
# Browser login prompt. Disabled unless ADMIN_PASSWORD is set (min 8 characters).
ADMIN_USER=admin
ADMIN_PASSWORD=

